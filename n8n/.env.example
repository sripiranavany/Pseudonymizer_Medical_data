# External LLM Provider — choose one and copy this file to .env

# Option A: Local Ollama (recommended — no rate limits, fully offline, GDPR-safe)
EXTERNAL_LLM_BASE_URL=http://ollama:11434/v1
EXTERNAL_LLM_API_KEY=ollama
EXTERNAL_LLM_MODEL=mistral

# Option B: OpenRouter (free tier — rate limits apply)
# EXTERNAL_LLM_BASE_URL=https://openrouter.ai/api/v1
# EXTERNAL_LLM_API_KEY=sk-or-v1-YOUR_KEY_HERE
# EXTERNAL_LLM_MODEL=google/gemma-4-31b-it:free

# Option C: Mistral La Plateforme (EU servers, GDPR-friendly, free Experiment tier)
# EXTERNAL_LLM_BASE_URL=https://api.mistral.ai/v1
# EXTERNAL_LLM_API_KEY=YOUR_MISTRAL_KEY_HERE
# EXTERNAL_LLM_MODEL=mistral-small-latest

# Local Ollama (PII detection — runs on-device)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral
